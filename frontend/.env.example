# Chain ID: 31337 = Hardhat local, 80002 = Polygon Amoy
VITE_CHAIN_ID=31337

# RPC for read-only calls (PublicTrace page, no wallet needed)
# Local dev: http://127.0.0.1:8545
# Amoy:      https://polygon-amoy-bor-rpc.publicnode.com  (free, no API key)
VITE_POLYGON_AMOY_RPC_URL=http://127.0.0.1:8545

# Auto-updated by scripts/setup.ts on deploy
VITE_CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3

# Pinata IPFS (optional, leave blank to skip image uploads)
# Sign up free at https://app.pinata.cloud
VITE_PINATA_JWT=
VITE_PINATA_GATEWAY=https://gateway.pinata.cloud

# WalletConnect project ID (optional, enables mobile MetaMask QR connect)
# Free at https://cloud.reown.com (formerly cloud.walletconnect.com)
VITE_WALLETCONNECT_PROJECT_ID=
