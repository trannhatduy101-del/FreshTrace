# Deployment
# Private key of the wallet that will deploy the contract.
# Leave blank if you only run tests or local Hardhat.
# Get free Amoy POL: https://faucet.polygon.technology
PRIVATE_KEY=

# RPC endpoint for the network you deploy to.
# Recommended free Amoy RPC: https://polygon-amoy-bor-rpc.publicnode.com
POLYGON_AMOY_RPC_URL=

# Wallet (single-wallet mode for Amoy deploy)
# If you want one wallet to receive all four participant roles, set this.
# scripts/setup.ts uses it as the fallback when per-role vars below are empty.
# scripts/fund.ts also sends 10 test ETH to this wallet on local Hardhat.
WALLET_ADDRESS=

# Wallet (per-role mode for Amoy deploy)
# Set these to give each role to its own wallet. Useful for a realistic demo
# where each actor lives on a different MetaMask account. If any one of them
# is set, the four are used; otherwise we fall back to WALLET_ADDRESS above.
# On local Hardhat these are ignored: setup.ts grants Producer to Hardhat
# account #1, Logistics to #2, Retailer to #3, Auditor to #4 automatically.
WALLET_PRODUCER=
WALLET_LOGISTICS=
WALLET_RETAILER=
WALLET_AUDITOR=

# Local Hardhat dev (defaults fine for most users)
HARDHAT_RPC_URL=http://127.0.0.1:8545
# Public Hardhat account #0 key. Safe to commit, only works on the local node.
HARDHAT_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Optional: post-deploy operations
# Used by scripts/grantRoles.ts to grant roles on an already-deployed contract.
CONTRACT_ADDRESS=

# Pinata IPFS (only needed for off-chain script uploads)
# Frontend Pinata config lives in frontend/.env (VITE_PINATA_JWT).
PINATA_API_KEY=
PINATA_SECRET_KEY=
